  <property name="styleSheet">
   <string notr="true">QPushButton#main_pushButton,#sound_recording_pushButton,#about_pushButton,#help_pushButton{
background-color: rgb(255, 117, 194);
border:rgb(255, 117, 194);
border-radius: 14;
}

QPushButton#main_pushButton:hover,#sound_recording_pushButton:hover,#about_pushButton:hover,#help_pushButton:hover{
background-color: rgba(255, 117, 194,200);
}

QPushButton#main_pushButton:pressed,#sound_recording_pushButton:pressed,#about_pushButton:pressed,#help_pushButton:pressed{
background-color: rgb(170, 88, 117);
}

QPushButton#close_pushButton{
 background-color: #ce5137;
 border-radius:10px;
}

QPushButton#close_pushButton:hover{
 background-size: cover;
 background-image: url(:/icon/icon/close.svg);
}

QPushButton#min_pushButton{
 background-color: #a1c661;
 border-radius:10px;
}

QPushButton#min_pushButton:hover{
 background-size: cover;
 background-image: url(:/icon/icon/minimize.svg);
}


QWidget#button_widget{
background-color: rgb(62, 32,110);
border-radius: 14;
